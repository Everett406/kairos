{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kairos",
  "version": "0.4.0",
  "identifier": "com.kairos.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Kairos",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "center": true,
        "shadow": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/LibreHardwareMonitor/*"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    }
  }
}
